MONGO_URI=mongodb://127.0.0.1:27017/attendance-app
PORT=4000
JWT_SECRET=
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application). Leave blank in dev to fall back to typed-email login.
GOOGLE_CLIENT_ID=
# Optional: extra staff accounts, comma-separated (bhuvaneswaran@ is built in).
EXTRA_STAFF_EMAILS=
# Optional: set to 1 to flag scans whose IP geolocates far from the classroom.
# Sends student IPs to ip-api.com over plain HTTP — update public/privacy.html first.
IP_GEOLOOKUP=
