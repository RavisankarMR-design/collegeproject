rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // One document per class. A signed-in staff member can read a class only
    // if their (verified) email is in that class's staffEmails list, so each
    // staff member gets their own classes and nothing else. Students have no
    // entry in any staffEmails, so they get nothing.
    // The app must query with where('staffEmails', 'array-contains', email);
    // a broader query is rejected. Emails are stored lowercase.
    match /classes/{classId} {
      allow read: if request.auth != null
                  && request.auth.token.email_verified == true
                  && request.auth.token.email.lower() in resource.data.staffEmails;
      allow write: if false; // loaded only by firebase/import-classes.js (Admin SDK bypasses rules)
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
